---
import type { Page } from '@easy-web/core/contracts';
import ComponentGallery from '../../components/gallery/ComponentGallery.astro';
import Base from '../../layouts/Base.astro';

const page: Page = {
  title: 'Component gallery',
  description: 'Live previews of every @easy-web/core component, rendered from the content contracts.',
};
---

<Base title={`${page.title} — easy-web`} description={page.description} lang="en">
  <ComponentGallery lang="en" page={page} />
</Base>
