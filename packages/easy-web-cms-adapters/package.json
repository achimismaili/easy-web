{
  "name": "@easy-web/cms-adapters",
  "version": "1.4.1",
  "packageManager": "pnpm@10.34.4",
  "type": "module",
  "private": false,
  "description": "Decap CMS integration for the easy-web ecosystem — AdminPage component, frontmatter types, and config scaffold.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./src/components/*.astro",
    "./components/*.astro": "./src/components/*.astro",
    "./src/components/*.astro": "./src/components/*.astro"
  },
  "files": [
    "dist",
    "src/components",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p src/content/tsconfig.tests.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@easy-web/core": "workspace:*"
  },
  "peerDependencies": {
    "astro": ">=6.0.0 <8.0.0",
    "sharp": "^0.35.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "astro": "^7.3.5",
    "sharp": "^0.35.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/achimismaili/easy-web.git",
    "directory": "packages/easy-web-cms-adapters"
  }
}
