{
  "name": "@easy-web/core",
  "version": "1.7.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "import": "./dist/recipes/index.js"
    },
    "./recipes/schema": {
      "types": "./dist/recipes/schema.d.ts",
      "import": "./dist/recipes/schema.js"
    },
    "./recipes/registry": {
      "types": "./dist/recipes/registry.d.ts",
      "import": "./dist/recipes/registry.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "import": "./dist/demo/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "import": "./dist/seo/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./components/*": "./src/components/*.astro",
    "./components/*.astro": "./src/components/*.astro",
    "./schemas/*": "./src/schemas/*.ts",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/fonts.css": "./styles/fonts.css"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "astro": ">=6.0.0 <8.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "unified": "^11",
    "unist-util-visit": "^5"
  },
  "devDependencies": {
    "@types/mdast": "^4",
    "astro": "^7.3.5",
    "typescript": "^5.5.0",
    "vfile": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/achimismaili/easy-web.git",
    "directory": "packages/core"
  },
  "license": "MIT"
}
