exports[`legacy rendering baseline > LegalLayout 1`] = `"<article class="ew-legal"><div class="ew-legal__inner"><h1 class="ew-legal__title">Impressum</h1><p class="ew-legal__updated">2025-01-01</p><div class="ew-legal__content"><p>Legal text</p></div></div></article>"`;

exports[`legacy rendering baseline > NotFound 1`] = `"<section class="ew-not-found" data-testid="not-found"><img src="/img/404.png" alt="" class="ew-not-found__image" loading="lazy"><h1 class="ew-not-found__heading">Nichts gefunden</h1><p class="ew-not-found__message">Diese Seite gibt es nicht.</p><p class="ew-not-found__actions"><a href="/" class="ew-not-found__link">Zur Startseite</a></p></section>"`;

exports[`legacy rendering baseline > PageShell 1`] = `"<a class="ew-skip-link" href="#main-content">Skip to main content</a><header>Header slot</header><!-- tabindex="-1" makes <main> programmatically focusable so activating the skip link moves focus as well as scroll position. Without it, some browsers scroll the viewport but leave focus in the nav, so the next Tab returns to the menu — the control appears to work while not actually bypassing anything. --><main id="main-content" class="ew-main" tabindex="-1"><p>Body content</p></main><footer>Footer slot</footer>"`;

exports[`legacy rendering baseline > Prose 1`] = `"<div class="ew-prose"><div class="ew-prose__inner"><h2>Heading</h2><p>Text</p></div></div>"`;

exports[`legacy rendering baseline > Section 1`] = `"<section class="ew-section" id="sec"><div class="ew-section__inner"><h2 class="ew-section__title">Section title</h2><p>Section body</p></div></section>"`;

