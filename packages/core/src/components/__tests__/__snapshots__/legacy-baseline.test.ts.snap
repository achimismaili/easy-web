exports[`legacy rendering baseline > GalleryLightboxGrid 1`] = `"<section class="ew-lightbox-wrap" data-lightbox-root><div class="ew-lightbox-wrap__inner"><h2 class="ew-lightbox-wrap__title">Lightbox</h2><div class="ew-lightbox-grid ew-lightbox-grid--cols-3 ew-lightbox-grid--gap-md"><button type="button" class="ew-lightbox-grid__item" data-index="0" data-title="Light 1" data-description="Desc 1" aria-label="Open L1"><img src="/img/l1.jpg" alt="L1" class="ew-lightbox-grid__img ew-lightbox-grid__img--ratio-square" loading="lazy"></button><button type="button" class="ew-lightbox-grid__item" data-index="1" aria-label="Open L2"><img src="/img/l2.jpg" alt="L2" class="ew-lightbox-grid__img ew-lightbox-grid__img--ratio-square" loading="lazy"></button></div><div class="ew-lightbox" role="dialog" aria-modal="true" aria-label="Lightbox" data-open="false" hidden><button type="button" class="ew-lightbox__close" aria-label="Close lightbox"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><button type="button" class="ew-lightbox__arrow ew-lightbox__arrow--prev" aria-label="Previous image"><svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg></button><button type="button" class="ew-lightbox__arrow ew-lightbox__arrow--next" aria-label="Next image"><svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg></button><figure class="ew-lightbox__figure"><img src alt class="ew-lightbox__img"><figcaption class="ew-lightbox__caption"><h3 class="ew-lightbox__caption-title"></h3><p class="ew-lightbox__caption-description"></p></figcaption></figure></div></div></section><script> (() => { const initLightbox = (root) => { if (root.dataset.lightboxInitialized) return; root.dataset.lightboxInitialized = 'true'; const modal = root.querySelector('.ew-lightbox'); const img = modal.querySelector('.ew-lightbox__img'); const captionTitle = modal.querySelector('.ew-lightbox__caption-title'); const captionDesc = modal.querySelector('.ew-lightbox__caption-description'); const closeBtn = modal.querySelector('.ew-lightbox__close'); const prevBtn = modal.querySelector('.ew-lightbox__arrow--prev'); const nextBtn = modal.querySelector('.ew-lightbox__arrow--next'); const triggers = Array.from(root.querySelectorAll('.ew-lightbox-grid__item')); let current = 0; let lastTrigger = null; const render = (idx) => { const next = ((idx % triggers.length) + triggers.length) % triggers.length; current = next; const trigger = triggers[current]; const thumbnail = trigger.querySelector('img'); img.src = thumbnail.currentSrc || thumbnail.src; img.alt = thumbnail.alt; captionTitle.textContent = trigger.dataset.title ?? ''; captionTitle.hidden = !trigger.dataset.title; captionDesc.textContent = trigger.dataset.description ?? ''; captionDesc.hidden = !trigger.dataset.description; }; const open = (idx, trigger) => { lastTrigger = trigger; render(idx); modal.hidden = false; modal.dataset.open = 'true'; document.body.style.overflow = 'hidden'; closeBtn.focus(); }; const close = () => { modal.dataset.open = 'false'; modal.hidden = true; document.body.style.overflow = ''; lastTrigger?.focus(); }; triggers.forEach((trigger, i) => { trigger.addEventListener('click', (event) => open(i, event.currentTarget)); }); closeBtn.addEventListener('click', close); prevBtn?.addEventListener('click', () => render(current - 1)); nextBtn?.addEventListener('click', () => render(current + 1)); modal.addEventListener('click', (e) => { if (e.target === modal) close(); }); document.addEventListener('keydown', (e) => { if (modal.dataset.open !== 'true') return; if (e.key === 'Escape') { e.preventDefault(); close(); } else if (e.key === 'ArrowLeft') { e.preventDefault(); render(current - 1); } else if (e.key === 'ArrowRight') { e.preventDefault(); render(current + 1); } }); }; document.querySelectorAll('[data-lightbox-root]').forEach(initLightbox); })(); </script>"`;

