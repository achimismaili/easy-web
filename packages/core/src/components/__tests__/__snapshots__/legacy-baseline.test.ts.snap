nt.addEventListener('keydown', (e) => { if (modal.dataset.open !== 'true') return; if (e.key === 'Escape') { e.preventDefault(); close(); } else if (e.key === 'ArrowLeft') { e.preventDefault(); render(current - 1); } else if (e.key === 'ArrowRight') { e.preventDefault(); render(current + 1); } }); }; document.querySelectorAll('[data-lightbox-root]').forEach(initLightbox); })(); </script>"`;

