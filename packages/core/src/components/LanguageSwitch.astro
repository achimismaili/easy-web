---
/**
 * LanguageSwitch - links to the alternate locale version of the current page.
 * Convention: default locale (e.g. "de") lives at `/`, non-default (e.g. "en") at `/en/.`.
 * With `alternates`, it renders one link per entry instead of deriving a single one.
 */
import type { LanguageSwitchProps } from '../contracts/props.js';
import { ambientTrailingSlash, toServedPath } from '../i18n/index.js';
import { resolveLabels } from './labels.js';

export type Props = LanguageSwitchProps;

const { lang = 'en', labels: labelOverrides } = Astro.props;
const labels = resolveLabels(lang, labelOverrides);
const { currentLang, pathname, defaultLocale = 'de', alternateHref: explicitHref, ariaLabel, alternates } = Astro.props;

const isDefault = currentLang === defaultLocale;
const alternateLang = isDefault ? 'en' : defaultLocale;
const label = alternateLang.toUpperCase();

function deriveAlternateHref(): string {
  if (isDefault) {
    return `/en${pathname === '/' ? '/' : pathname}`;
  }
  const stripped = pathname.replace(/^\/en\/?/, '/');
  return stripped || '/';
}

// Render in the form the site serves, so switching language is a direct hit
// rather than a redirect. Also normalises any alternateHref a page passes in.
const trailingSlash = ambientTrailingSlash();
const links = alternates
  ? alternates.map((alternate) => ({
      href: toServedPath(alternate.href, trailingSlash),
      hreflang: alternate.lang,
      text: alternate.label ?? alternate.lang.toUpperCase(),
      // The accessible name contains a custom visible label (WCAG 2.5.3).
      ariaLabel: labels.switchToLanguage(alternate.label ?? alternate.lang),
    }))
  : [
      {
        href: toServedPath(explicitHref ?? deriveAlternateHref(), trailingSlash),
        hreflang: alternateLang,
        text: label,
        ariaLabel: ariaLabel ?? labels.switchToLanguage(alternateLang),
      },
    ];
---

{links.map((link) => (
  <a href={link.href} class="ew-lang-switch" aria-label={link.ariaLabel} hreflang={link.hreflang}>
    {link.text}
  </a>
))}

<style>
  .ew-lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    /* Same shared header-control height as ThemeToggle for a consistent utility row. */
    height: 2.25rem;
    min-width: 2.5rem;
    padding: 0 var(--ew-space-2);
    border: 1px solid var(--ew-border);
    border-radius: var(--ew-radius-md);
    color: var(--ew-on-surface);
    font-family: var(--ew-font-sans);
    font-size: var(--ew-text-sm);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .ew-lang-switch:hover {
    background: var(--ew-surface-muted);
  }
  .ew-lang-switch:focus-visible {
    outline: 2px solid var(--ew-primary);
    outline-offset: 2px;
  }
</style>
