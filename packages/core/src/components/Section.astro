---
/**
 * Section – semantic wrapper with optional heading, constrained width, and slot.
 * Pure Astro component using --ew-* design tokens.
 */
import type { SectionProps } from '../contracts/props.js';
import { scopeAttributes } from './scope-attributes.js';

export type Props = SectionProps;

const { title, id, class: className } = Astro.props;
---

<section class:list={['ew-section', className]} id={id} {...scopeAttributes(className, Astro.props)}>
  <div class="ew-section__inner">
    {title && <h2 class="ew-section__title">{title}</h2>}
    <slot />
  </div>
</section>

<style>
  .ew-section {
    padding: var(--ew-space-8) var(--ew-space-5);
  }
  .ew-section__inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .ew-section__title {
    font-family: var(--ew-font-sans);
    font-size: var(--ew-text-xl);
    font-weight: 700;
    color: var(--ew-on-surface);
    margin: 0 0 var(--ew-space-5);
    line-height: var(--ew-leading-tight);
  }
</style>
