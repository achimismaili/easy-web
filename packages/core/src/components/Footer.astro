---
/**
 * Footer – site footer with copyright line and legal links.
 * Optional `columns` of links render above that row, and the named `actions`
 * slot places controls (theme toggle, back-to-top) beside the legal links.
 * Pure Astro component using theme tokens only.
 */
import type { FooterProps } from '../contracts/props.js';
import { resolveLabels } from './labels.js';

export type Props = FooterProps;

const { lang = 'en', labels: labelOverrides } = Astro.props;
const labels = resolveLabels(lang, labelOverrides);
const { siteName, legalLinks, currentYear = new Date().getFullYear(), columns = [] } = Astro.props;
---

<footer class="ew-footer">
  {columns.length > 0 && (
    <div class="ew-footer__columns">
      {columns.map((column) => (
        <div class="ew-footer__column">
          {column.title && <h2 class="ew-footer__column-title">{column.title}</h2>}
          <ul class="ew-footer__column-links">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="ew-footer__link" rel={link.external ? 'external' : undefined}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
  <div class="ew-footer__inner">
    <p class="ew-footer__copyright">&copy; {currentYear} {siteName}</p>
    {legalLinks.length > 0 && (
      <nav class="ew-footer__legal" aria-label={labels.legal}>
        <ul class="ew-footer__links">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="ew-footer__link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {Astro.slots.has('actions') && (
      <div class="ew-footer__actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</footer>

<style>
  .ew-footer {
    background: var(--ew-surface-muted);
    border-top: 1px solid var(--ew-border);
    color: var(--ew-on-surface);
    font-family: var(--ew-font-sans);
    font-size: var(--ew-text-sm);
  }
  .ew-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--ew-space-6) var(--ew-space-5);
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--ew-space-6) var(--ew-space-5) 0;
  }
  .ew-footer__column-title {
    margin: 0 0 var(--ew-space-3);
    color: var(--ew-on-surface);
    font-size: var(--ew-text-sm);
    font-weight: 600;
    line-height: var(--ew-leading-tight);
  }
  .ew-footer__column-links {
    display: flex;
    flex-direction: column;
    gap: var(--ew-space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ew-footer__actions {
    display: flex;
    align-items: center;
    gap: var(--ew-space-2);
  }
  .ew-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ew-space-3);
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--ew-space-6) var(--ew-space-5);
    text-align: center;
  }
  .ew-footer__copyright {
    margin: 0;
    color: var(--ew-muted);
  }
  .ew-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--ew-space-4);
  }
  .ew-footer__link {
    color: var(--ew-muted);
    text-decoration: none;
  }
  .ew-footer__link:hover {
    color: var(--ew-on-surface);
  }
  .ew-footer__link:focus-visible {
    outline: 2px solid var(--ew-primary);
    outline-offset: 2px;
  }

  @media (min-width: 769px) {
    .ew-footer__inner {
      flex-direction: row;
      justify-content: space-between;
    }
    /* Pushes the legal links and any actions to the end as one group. With
       only the copyright and the legal links this matches space-between. */
    .ew-footer__copyright {
      margin-inline-end: auto;
    }
  }
</style>
