{
  "name": "@easy-web/cli",
  "version": "0.1.1",
  "description": "Create-only command-line interface for generating easy-web sites.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "easy-web": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "mri": "^1.2.0",
    "@easy-web/core": "workspace:*",
    "@easy-web/auth": "workspace:*",
    "@easy-web/cms-adapters": "workspace:*",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "execa": "^9.6.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "provenance": true
  },
  "packageManager": "pnpm@10.34.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/achimismaili/easy-web.git",
    "directory": "packages/easy-web-cli"
  },
  "license": "MIT"
}
