---
/**
 * @deprecated Import `@easy-web/core/components/PageShell.astro` instead.
 * Compatibility wrapper: renders the core component with the same props and slots.
 */
import type { ComponentProps } from 'astro/types';
import PageShell from '@easy-web/core/components/PageShell.astro';

type Props = ComponentProps<typeof PageShell>;

const props = Astro.props;
---
<PageShell {...props}>{Astro.slots.has('header') && <Fragment slot="header"><slot name="header" /></Fragment>}<slot />{Astro.slots.has('footer') && <Fragment slot="footer"><slot name="footer" /></Fragment>}</PageShell>
