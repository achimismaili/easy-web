---
/**
 * @deprecated Import `@easy-web/core/components/HeaderHideOnScroll.astro` instead.
 * Compatibility wrapper: renders the core component with the same props and slots.
 *
 * The `actions` slot is forwarded only when the caller fills it. Astro registers
 * a slot even when its `{cond && <Fragment slot>}` expression is false, which
 * would replace the core fallback (theme toggle and language switch) with nothing.
 */
import type { ComponentProps } from 'astro/types';
import HeaderHideOnScroll from '@easy-web/core/components/HeaderHideOnScroll.astro';

type Props = ComponentProps<typeof HeaderHideOnScroll>;

const props = Astro.props;
---
{Astro.slots.has('actions')
  ? <HeaderHideOnScroll {...props}><Fragment slot="actions"><slot name="actions" /></Fragment></HeaderHideOnScroll>
  : <HeaderHideOnScroll {...props} />}
